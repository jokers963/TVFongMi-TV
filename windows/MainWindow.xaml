<Window x:Class="TVFongMi.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="影視TV" Width="1280" Height="800" Background="#111318" Foreground="#F4F4F5"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,24"><TextBlock Text="影視TV" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/><Button Content="恢复配置" Click="Restore_Click" Width="90" Height="34" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button Content="备份配置" Click="Backup_Click" Width="90" Height="34" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button Content="检查源" Click="CheckSources_Click" Width="90" Height="34" DockPanel="Right" Margin="8,0,0,0"/><Button Content="导入本地 JSON" Click="ImportFile_Click" Width="120" Height="34" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button Content="从 URL 导入" Click="ImportUrl_Click" Width="110" Height="34" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="SearchBox" Width="280" Height="34" Margin="0,0,12,0" DockPanel.Dock="Right" VerticalContentAlignment="Center" ToolTip="搜索影视内容"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox Background="#191C22" BorderThickness="0" Padding="8"><ListBoxItem Content="首页" Padding="12"/><ListBoxItem Content="电影" Padding="12"/><ListBoxItem Content="电视剧" Padding="12"/><ListBoxItem Content="综艺" Padding="12"/><ListBoxItem Content="动漫" Padding="12"/><ListBoxItem Content="收藏与历史" Padding="12"/></ListBox><Border Grid.Column="1" Margin="20,0,0,0" Background="#191C22" CornerRadius="8" Padding="24"><StackPanel><TextBlock Text="影视源" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/><ListBox x:Name="SourceList" Background="Transparent" BorderThickness="0" DisplayMemberPath="Name"/><TextBlock x:Name="StatusText" Text="尚未导入影视源" Margin="0,16,0,0" Opacity="0.7"/></StackPanel></Border></Grid></Grid></Window>

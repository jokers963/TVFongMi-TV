<Window x:Class="TVFongMi.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="影視TV" Width="1280" Height="800" Background="#111318" Foreground="#F4F4F5">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,24"><TextBlock Text="影視TV" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/><Button Content="恢复配置" Click="Restore_Click" Width="90" Height="34" DockPanel.Dock="Right"/><Button Content="备份配置" Click="Backup_Click" Width="90" Height="34" DockPanel.Dock="Right"/><Button Content="检查源" Click="CheckSources_Click" Width="90" Height="34" DockPanel.Dock="Right"/><Button Content="导入本地 JSON" Click="ImportFile_Click" Width="120" Height="34" DockPanel.Dock="Right"/><Button Content="从 URL 导入" Click="ImportUrl_Click" Width="110" Height="34" DockPanel.Dock="Right"/><TextBox x:Name="SearchBox" Width="280" Height="34" DockPanel.Dock="Right" TextChanged="SearchBox_TextChanged"/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox Background="#191C22" SelectionChanged="Category_SelectionChanged"><ListBoxItem Content="首页" Tag=""/><ListBoxItem Content="电影" Tag="电影"/><ListBoxItem Content="电视剧" Tag="电视剧"/><ListBoxItem Content="综艺" Tag="综艺"/><ListBoxItem Content="动漫" Tag="动漫"/><ListBoxItem Content="收藏与历史" Tag=""/></ListBox><Border Grid.Column="1" Margin="20,0,0,0" Background="#191C22" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="影视内容" FontSize="24" FontWeight="Bold"/><ListBox x:Name="SourceList" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="SourceList_SelectionChanged"/><ScrollViewer Grid.Row="2"><ItemsControl x:Name="VideoList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="150" Margin="0,12,16,0"><Image Height="205" Source="{Binding Poster}" Stretch="UniformToFill"/><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock x:Name="StatusText" Grid.Row="2" VerticalAlignment="Top"/></Grid></Border></Grid>
  </Grid>
</Window>
